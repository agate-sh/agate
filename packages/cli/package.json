{
  "name": "@agate/cli",
  "version": "0.1.0",
  "description": "Agate CLI commands",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agate": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agate/server": "workspace:^",
    "@agate/sdk": "workspace:^",
    "@agate/shared": "workspace:^",
    "chalk": "^5.3.0",
    "execa": "^9.5.2",
    "ws": "^8.18.3",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.33",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
