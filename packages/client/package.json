{
  "name": "@agate/client",
  "version": "0.1.0",
  "description": "Agate terminal UI client",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agate-client": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "bun src/index.tsx",
    "start": "bun src/index.tsx",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agate/sdk": "workspace:^",
    "@agate/shared": "workspace:^",
    "@opentui/core": "^0.1.27",
    "@opentui/react": "^0.1.27",
    "@xterm/headless": "^5.5.0",
    "chalk": "^5.3.0",
    "react": "^19.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/ws": "^8.18.1",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
