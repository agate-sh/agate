#!/usr/bin/env bash

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Agent-specific configuration
get_agent_color() {
    case "$1" in
        claude)   printf "\033[38;2;218;119;86m" ;;    # #da7756
        amp)      printf "\033[38;2;182;191;105m" ;;   # #b6bf69
        gemini)   printf "\033[38;2;205;169;252m" ;;   # #cda9fc
        codex)    printf "\033[38;2;108;144;142m" ;;   # #6c908e
        opencode) printf "\033[38;2;255;186;136m" ;;   # #ffba88
        cursor)   printf "\033[38;2;255;255;255m" ;;   # #ffffff
        copilot)  printf "\033[38;2;129;161;190m" ;;   # #81a1be
        cn)       printf "\033[38;2;55;130;166m" ;;    # #3782a6
        *)        printf "" ;;
    esac
}

get_agent_name() {
    case "$1" in
        claude)   echo "Claude" ;;
        amp)      echo "Amp" ;;
        gemini)   echo "Gemini" ;;
        codex)    echo "Codex" ;;
        opencode) echo "OpenCode" ;;
        cursor)   echo "Cursor" ;;
        copilot)  echo "GitHub Copilot" ;;
        cn)       echo "Continue" ;;
        *)        echo "" ;;
    esac
}

# Configuration
REPO_OWNER="agate-sh"
REPO_NAME="agate"
BINARY_NAME="agate"
INSTALL_DIR="$HOME/.agate/bin"
GITHUB_BASE_URL="https://github.com/${REPO_OWNER}/${REPO_NAME}"

# Print functions (inspired by Cursor's approach)
print_step() {
    printf "\n${CYAN}${BOLD}▸${NC} %s\n" "$1"
}

print_success() {
    printf "${GREEN}${BOLD}✓${NC} %s\n" "$1"
}

print_error() {
    printf "${RED}${BOLD}✗${NC} %s\n" "$1" >&2
}

print_warn() {
    printf "${YELLOW}${BOLD}⚠${NC} %s\n" "$1"
}

print_info() {
    printf "  ${CYAN}%s${NC}\n" "$1"
}

print_dim() {
    printf "\033[2m%s${NC}\n" "$1"
}

# Legacy Helper functions
info() {
    printf "${CYAN}▸${NC} %s\n" "$1"
}

success() {
    printf "${GREEN}✓${NC} %s\n" "$1"
}

error() {
    printf "${RED}✗${NC} %s\n" "$1" >&2
}

warn() {
    printf "${YELLOW}⚠${NC} %s\n" "$1"
}


die() {
    print_error "$1"
    printf "\n${RED}${BOLD}✗${NC}${BOLD} Installation failed${NC}\n\n"
    printf "For help, please open an issue:\n"
    printf "\033[2m\033[4mhttps://github.com/agate-sh/agate/issues/new${NC}\n\n"
    exit 1
}

success_box() {
    local agents_list="$1"
    local shell_config="$2"

    printf "\n${GREEN}${BOLD}✓${NC}${BOLD} Installation successful${NC}\n\n"
    printf "${BOLD}📋 Get started${NC}\n\n"
    printf "${BOLD}1.${NC} Reload shell\n"
    printf "   \033[2msource ${shell_config}${NC}\n\n"
    printf "${BOLD}2.${NC} Run agate with your agents\n"
    printf "   \033[2magate --agents ${agents_list} \"Create or update AGENTS.md\"${NC}\n\n"
}

# Detect OS and architecture
detect_platform() {
    local os arch

    # Detect OS
    case "$(uname -s)" in
        Darwin*)
            os="darwin"
            ;;
        Linux*)
            os="linux"
            ;;
        MINGW* | MSYS* | CYGWIN*)
            os="windows"
            ;;
        *)
            die "Unsupported operating system: $(uname -s)"
            ;;
    esac

    # Detect architecture
    case "$(uname -m)" in
        x86_64 | amd64)
            # Check if running under Rosetta 2 on macOS
            if [[ "$os" == "darwin" ]] && [[ "$(sysctl -n sysctl.proc_translated 2>/dev/null)" == "1" ]]; then
                arch="arm64"
            else
                arch="amd64"
            fi
            ;;
        arm64 | aarch64)
            arch="arm64"
            ;;
        armv7l | armv6l)
            arch="arm"
            ;;
        *)
            die "Unsupported architecture: $(uname -m)"
            ;;
    esac

    echo "${os}_${arch}"
}

# Get the latest version from GitHub
get_latest_version() {
    local version
    version=$(curl -sS "https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/releases/latest" | \
              grep '"tag_name"' | \
              sed -E 's/.*"v?([^"]+)".*/\1/')

    if [[ -z "$version" ]]; then
        return 1
    fi

    echo "$version"
}

# Check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Check and install dependencies
check_dependencies() {
    local missing_deps=()
    local found_deps=()
    local os_type="$1"  # Pass OS type from detect_platform

    # Check for curl (still needed for downloading)
    if ! command_exists curl; then
        die "curl is required but not installed. Please install curl and try again."
    fi

    # Check for tmux (required for agate to run)
    if command_exists tmux; then
        found_deps+=("tmux")
    else
        missing_deps+=("tmux")
    fi

    # Check for agent CLI if specified
    if [[ -n "$agent" ]]; then
        if command_exists "$agent"; then
            found_deps+=("$agent")
        else
            missing_deps+=("$agent")
        fi
    fi

    # Check for gh (GitHub CLI)
    # if command_exists gh; then
    #     found_deps+=("gh")
    # else
    #     missing_deps+=("gh")
    # fi

    # Check for delta (git diff pager)
    if ! command_exists delta; then
        print_info "Installing delta, a syntax-highlighting git diff pager"
        install_delta "$os_type"
        if command_exists delta; then
            found_deps+=("delta")
        else
            missing_deps+=("delta")
        fi
    else
        found_deps+=("delta")
    fi

    # Report missing dependencies
    if [[ ${#missing_deps[@]} -gt 0 ]]; then
        for dep in "${missing_deps[@]}"; do
            if [[ "$dep" == "$agent" ]]; then
                printf "${YELLOW}${BOLD}⚠${NC} ${AGENT_COLOR}${dep}${NC} not found. You'll need to install it separately.\n"
            elif [[ "$dep" == "tmux" ]]; then
                print_warn "tmux not found. You'll need to install it to use agate."
                # Show OS-specific install command
                case "$os_type" in
                    darwin*)
                        print_info "brew install tmux"
                        ;;
                    linux*)
                        # Try to detect Linux distro
                        if command_exists apt-get; then
                            print_info "sudo apt-get install tmux"
                        elif command_exists yum; then
                            print_info "sudo yum install tmux"
                        elif command_exists pacman; then
                            print_info "sudo pacman -S tmux"
                        else
                            print_info "Install tmux using your package manager"
                        fi
                        ;;
                    windows*)
                        print_info "Install tmux using WSL or a package manager like Chocolatey"
                        ;;
                esac
            else
                print_warn "${dep} not found. You'll need to install it separately."
            fi
        done
    fi

    # Show found dependencies only if no dependencies are missing
    if [[ ${#missing_deps[@]} -eq 0 ]] && [[ ${#found_deps[@]} -gt 0 ]]; then
        local deps_list
        deps_list=$(printf '%s, ' "${found_deps[@]}")
        deps_list=${deps_list%, }  # Remove trailing comma and space
        printf "${GREEN}${BOLD}✓${NC} All dependencies found \033[2m($deps_list)${NC}\n"
    fi
}

# Install delta (git diff pager)
install_delta() {
    local os_type="$1"
    local install_dir="$HOME/.local/bin"

    # Create install directory
    mkdir -p "$install_dir"

    # Detect architecture
    local arch
    case "$(uname -m)" in
        x86_64 | amd64) arch="x86_64" ;;
        arm64 | aarch64) arch="aarch64" ;;
        *) return 1 ;;
    esac

    # Get latest version
    local version
    version=$(curl -sS "https://api.github.com/repos/dandavison/delta/releases/latest" | \
              grep '"tag_name"' | \
              sed -E 's/.*"([^"]+)".*/\1/')

    if [[ -z "$version" ]]; then
        return 1
    fi

    # Construct download URL based on OS
    local download_url
    local archive_name

    case "$os_type" in
        darwin)
            archive_name="delta-${version}-${arch}-apple-darwin.tar.gz"
            ;;
        linux)
            archive_name="delta-${version}-${arch}-unknown-linux-gnu.tar.gz"
            ;;
        *)
            return 1
            ;;
    esac

    download_url="https://github.com/dandavison/delta/releases/download/${version}/${archive_name}"

    # Download and extract
    local temp_dir
    temp_dir=$(mktemp -d) || return 1

    if curl -sS -L -f -o "${temp_dir}/${archive_name}" "$download_url" 2>/dev/null; then
        cd "$temp_dir"
        tar xzf "$archive_name" 2>/dev/null

        # Find and move the delta binary
        find . -name "delta" -type f -perm +111 -exec mv {} "$install_dir/delta" \; 2>/dev/null
        chmod +x "$install_dir/delta" 2>/dev/null

        # Add to PATH for current session
        if [[ ":$PATH:" != *":$install_dir:"* ]]; then
            export PATH="$install_dir:$PATH"
        fi

        # Cleanup
        rm -rf "$temp_dir"

        return 0
    fi

    rm -rf "$temp_dir"
    return 1
}

# Download and install the binary
install_agate() {
    local platform="$1"
    local version="$2"
    local install_path="${INSTALL_DIR}/${BINARY_NAME}"
    local temp_dir
    local is_upgrade="$3"

    # Create temporary directory
    temp_dir=$(mktemp -d) || die "Failed to create temporary directory"
    trap "rm -rf '$temp_dir'" EXIT

    # Determine archive format
    local archive_ext
    case "$platform" in
        windows*)
            archive_ext=".zip"
            install_path="${install_path}.exe"
            ;;
        *)
            archive_ext=".tar.gz"
            ;;
    esac

    # Construct download URL
    local archive_name="${BINARY_NAME}_${version}_${platform}${archive_ext}"
    local download_url="${GITHUB_BASE_URL}/releases/download/v${version}/${archive_name}"

    # Download the archive
    if ! curl -sS -L -f -o "${temp_dir}/${archive_name}" "$download_url"; then
        die "Failed to download Agate v${version} for ${platform}"
    fi

    # Extract the archive
    cd "$temp_dir"
    case "$archive_ext" in
        .tar.gz)
            tar xzf "$archive_name" || die "Failed to extract archive"
            ;;
        .zip)
            unzip -q "$archive_name" || die "Failed to extract archive"
            ;;
    esac

    # Create install directory
    mkdir -p "$INSTALL_DIR" || die "Failed to create installation directory"

    # Move binary to installation directory
    local binary_file="${BINARY_NAME}"
    [[ "$platform" == windows* ]] && binary_file="${binary_file}.exe"

    if [[ ! -f "$binary_file" ]]; then
        die "Binary not found in archive"
    fi

    mv "$binary_file" "$install_path" || die "Failed to install binary"
    chmod +x "$install_path" || die "Failed to make binary executable"

    if [[ "$is_upgrade" == "true" ]]; then
        printf "${GREEN}${BOLD}✓${NC} Updated \033[3magate\033[0m \033[2m(v${version})${NC}\n"
    else
        printf "${GREEN}${BOLD}✓${NC} Installed \033[3magate\033[0m \033[2m(v${version})${NC}\n"
    fi
}

# Update shell configuration
update_shell_config() {
    local shell_config
    local shell_name

    # Detect shell configuration file
    case "${SHELL}" in
        */bash)
            shell_name="bash"
            if [[ -f "$HOME/.bash_profile" ]]; then
                shell_config="$HOME/.bash_profile"
            else
                shell_config="$HOME/.bashrc"
            fi
            ;;
        */zsh)
            shell_name="zsh"
            shell_config="$HOME/.zshrc"
            ;;
        */fish)
            shell_name="fish"
            shell_config="$HOME/.config/fish/config.fish"
            ;;
        *)
            shell_name="unknown"
            shell_config=""
            ;;
    esac

    # Check if directory is already in shell config
    if [[ -n "$shell_config" ]] && [[ -f "$shell_config" ]] && grep -q "${INSTALL_DIR}" "$shell_config"; then
        printf "${GREEN}${BOLD}✓${NC} Installation directory already in PATH \033[2m(${shell_config})${NC}\n" >&2
        # Return the shell config path for success box
        echo "$shell_config"
        return
    fi

    # Add to PATH
    if [[ -n "$shell_config" ]]; then
        # Create config file if it doesn't exist
        [[ ! -f "$shell_config" ]] && touch "$shell_config"

        # Add PATH export for agate
        if [[ "$shell_name" == "fish" ]]; then
            echo "" >> "$shell_config"
            echo "# agate" >> "$shell_config"
            echo "set -gx PATH \$PATH ${INSTALL_DIR}" >> "$shell_config"
        else
            echo "" >> "$shell_config"
            echo "# agate" >> "$shell_config"
            echo "export PATH=\"\$PATH:${INSTALL_DIR}\"" >> "$shell_config"
        fi

        printf "${GREEN}${BOLD}✓${NC} Added \033[3magate\033[0m to shell \033[2m(${shell_config})${NC}\n" >&2
        echo "$shell_config"  # Return the shell config path
    else
        warn "Could not detect shell configuration file"
        warn "Please add ${INSTALL_DIR} to your PATH manually"
        echo ""  # Return empty if no shell config
    fi
}

# Check for existing installation
check_existing_installation() {
    if [[ -f "${INSTALL_DIR}/${BINARY_NAME}" ]]; then
        local current_version
        current_version=$("${INSTALL_DIR}/${BINARY_NAME}" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' || echo "unknown")

        if [[ "$current_version" == "$1" ]]; then
            printf "${GREEN}${BOLD}✓${NC} Agate already installed \033[2m(v${current_version})${NC}\n"
            return 1  # Return error to skip installation but continue to success box
        else
            printf "${GREEN}${BOLD}✓${NC} Found existing installation \033[2m(v${current_version})${NC}\n"
        fi
    fi
}

# Main installation flow
main() {
    # Parse arguments for --agents flag
    local agents_list=""
    local agent=""
    local agent_display=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --agents)
                shift
                agents_list="$1"
                shift
                ;;
            *)
                # Legacy support: first argument without flag is treated as single agent
                if [[ -z "$agent" ]]; then
                    agent="$1"
                fi
                shift
                ;;
        esac
    done

    # If --agents was provided, use the first agent from the list for dependency checking
    if [[ -n "$agents_list" ]]; then
        agent="${agents_list%%,*}"  # Get first agent from comma-separated list
    fi

    # Always show installer header
    printf "\n${BOLD}🪨 Agate installer${NC}\n\n"

    # Check for existing installation first
    if [[ -f "${INSTALL_DIR}/${BINARY_NAME}" ]]; then
        local current_version
        current_version=$("${INSTALL_DIR}/${BINARY_NAME}" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' || echo "unknown")

        # Get latest version to check if up to date
        local latest_version
        latest_version=$(get_latest_version 2>/dev/null || echo "")

        if [[ "$current_version" == "$latest_version" ]]; then
            printf "${GREEN}${BOLD}✓${NC} Agate already installed \033[2m(v${current_version})${NC}\n"
            exit 0
        fi
    fi

    # Set agent color if agent is specified
    if [[ -n "$agent" ]]; then
        AGENT_COLOR=$(get_agent_color "$agent")
        agent_display=$(get_agent_name "$agent")
        if [[ -z "$AGENT_COLOR" ]] || [[ -z "$agent_display" ]]; then
            warn "Unknown agent: $agent"
            agent=""
            AGENT_COLOR=""
        fi
    fi

    # Get latest version
    local version
    if ! version=$(get_latest_version); then
        die "Unable to fetch latest version from GitHub API"
    fi
    printf "${GREEN}${BOLD}✓${NC} Downloaded latest version \033[2m(v${version})${NC}\n"

    # Detect platform
    local platform
    platform=$(detect_platform)

    # Extract OS type from platform (e.g., "darwin" from "darwin_arm64")
    local os_type="${platform%%_*}"

    # Check existing installation for upgrade
    local skip_install=false
    if ! check_existing_installation "$version"; then
        skip_install=true
    fi

    # Check dependencies (pass OS type for platform-specific messages)
    check_dependencies "$os_type"

    # Install Agate (unless already installed)
    local is_upgrade=false
    if [[ "$skip_install" != "true" ]]; then
        # Check if this is an upgrade
        if [[ -f "${INSTALL_DIR}/${BINARY_NAME}" ]]; then
            is_upgrade=true
        fi
        install_agate "$platform" "$version" "$is_upgrade"
    fi

    # Always update shell configuration (it will check if already in PATH)
    local shell_config_path
    shell_config_path=$(update_shell_config)

    # Final success message
    if [[ -n "$agents_list" ]]; then
        success_box "$agents_list" "$shell_config_path"
    elif [[ -n "$agent" ]]; then
        success_box "$agent" "$shell_config_path"
    else
        success_box "claude" "$shell_config_path"
    fi
}

# Support piping to bash
if [[ "${BASH_SOURCE[0]:-}" == "${0}" ]] || [[ -z "${BASH_SOURCE[0]:-}" ]]; then
    main "$@"
fi